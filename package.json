{
  "name": "actoris-test-automation-platform",
  "version": "0.1.0",
  "description": "Enterprise-grade TypeScript test automation starter aligned to gTAA, BDD, keyword-driven, and data-driven patterns.",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:bdd": "cucumber-js",
    "test:keyword": "tsx src/cli/run-keyword.ts scenarios/login.keyword.json",
    "test:google": "tsx src/cli/run-google-search.ts",
    "test:vnexpress:ai": "tsx src/cli/run-vnexpress-sport-ai.ts",
    "test:ui:smoke": "tsx src/cli/run-ui-smoke.ts",
    "test:mobile:smoke": "tsx src/cli/run-mobile-smoke.ts",
    "mock:start": "tsx src/mock/server.ts"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "js-yaml": "^4.1.1",
    "openai": "^6.29.0",
    "pino": "^10.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.27.0",
    "playwright": "^1.58.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
